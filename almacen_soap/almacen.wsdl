<?xml version="1.0" encoding="utf-8"?>
<!--
  Contrato del servicio de almacén. Se lee de abajo hacia arriba:
  service (dónde está) -> binding (cómo se habla: SOAP sobre HTTP)
  -> portType (qué operaciones hay) -> message (qué entra y qué sale)
  -> types (de qué tipo es cada dato).
-->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:alm="http://utvt.edu.mx/almacen"
             targetNamespace="http://utvt.edu.mx/almacen"
             name="Almacen">

  <types>
    <xsd:schema targetNamespace="http://utvt.edu.mx/almacen" elementFormDefault="qualified">
      <xsd:element name="ConsultarExistencia">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="producto" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ConsultarExistenciaResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="producto" type="xsd:string"/>
            <xsd:element name="existencia" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="ConsultarExistenciaEntrada">
    <part name="parameters" element="alm:ConsultarExistencia"/>
  </message>
  <message name="ConsultarExistenciaSalida">
    <part name="parameters" element="alm:ConsultarExistenciaResponse"/>
  </message>

  <portType name="AlmacenPortType">
    <operation name="ConsultarExistencia">
      <input message="alm:ConsultarExistenciaEntrada"/>
      <output message="alm:ConsultarExistenciaSalida"/>
    </operation>
  </portType>

  <binding name="AlmacenBinding" type="alm:AlmacenPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="ConsultarExistencia">
      <soap:operation soapAction="http://utvt.edu.mx/almacen/ConsultarExistencia"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="AlmacenService">
    <port name="AlmacenPort" binding="alm:AlmacenBinding">
      <soap:address location="http://127.0.0.1:8001/almacen"/>
    </port>
  </service>
</definitions>
